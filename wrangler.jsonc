{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lgka-bugreport",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "bugreport.lgka.app", "custom_domain": true }],
  // Privacy: our own log lines only. No per-request invocation logs, so no
  // request metadata (IP, UA, path) is retained anywhere.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 }
  },
  // EU-jurisdiction database, same stance as the API: school data stays in the EU.
  "d1_databases": [
    { "binding": "DB", "database_name": "lgka-bugreport", "database_id": "09657805-48c9-40fe-90d9-44ac9705fcd9" }
  ]
}
